  "objective_function_formula": "min sum_{t=0}^{H-1} w_t * [ c_curt * (p_curt_sol + p_curt_wind) + c_deg * (p_chg + p_dis) + c_dies_marg * p_diesel + c_dies_base * u_diesel + c_start * v_start ] + c_unmet * p_unmet",
